# StudyPulse — Environment Configuration Template
# Copy this file to .env and adjust values for your environment.

# Server Port and Host
PORT=3000
HOST=0.0.0.0

# Environment Mode: development | production | test
NODE_ENV=production

# Database Configuration
# In containerized environments, point to a mounted persistent volume path (e.g. /app/data/study_dashboard.db)
DB_PATH=./data/study_dashboard.db

# CORS Configuration
# Set to '*' for all origins, or comma-separated allowed production origins (e.g. https://studypulse.example.com)
CORS_ORIGIN=*

# Session / Auth Secrets
# Optional cryptographic salt/secret override for token and session generation
SESSION_SECRET=your-random-32-byte-secret-key-here
